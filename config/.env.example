# Database Configuration
# On cPanel: MySQL Databases > create DB + user, then note the full
# prefixed names (e.g. cpaneluser_inventory / cpaneluser_dbuser).
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_dbuser
DB_PASSWORD=
DB_NAME=cpaneluser_inventory

# Application Settings
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Email Configuration (for password reset)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_EMAIL=noreply@jerseystore.com
MAIL_FROM_NAME=Inventory System

# Session Configuration
SESSION_TIMEOUT=3600
SESSION_NAME=inventory_session

# File Upload Configuration
MAX_UPLOAD_SIZE=5242880
UPLOAD_PATH=/uploads/
